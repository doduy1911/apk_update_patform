{
  "name": "apk-update-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run src",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "node --env-file=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js --migrations-dir migrations --migrations-table schema_migrations up",
    "db:rollback": "node --env-file=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js --migrations-dir migrations --migrations-table schema_migrations down",
    "admin:create": "tsx src/cli/admin-create.ts",
    "token:create": "tsx src/cli/token-create.ts",
    "token:revoke": "tsx src/cli/token-revoke.ts"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.0.2",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "zod": "^4.1.12",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/multer": "^2.0.0",
    "@types/yauzl": "^2.10.3",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
